use gtk4::prelude::*;

fn main() {
    let app = gtk4::Application::builder()
        .application_id("com.mpdclient.app")
        .build();

    app.connect_activate(|app| {
        let win = gtk4::ApplicationWindow::new(app);
        win.set_title(Some("MPD Client"));
        win.set_default_size(1200, 800);
        win.present();
    });

    app.run();
}
